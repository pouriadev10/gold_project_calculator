# نمونه‌ی متغیرهای محیطی بک‌اند — این فایل در Git است، `.env` هرگز نیست.
#
#   cp apps/api/.env.example apps/api/.env
#
# هر متغیر بدون مقدار در این فایل، **اجباری** است: تا پرش نکنی سرور بالا نمی‌آید
# و پیام خطا دقیقاً نام همان متغیر را می‌گوید.

# development | test | production
NODE_ENV=development

PORT=3000

# fatal | error | warn | info | debug | trace
LOG_LEVEL=info

# اتصال PostgreSQL. رمز داخل خود URL است، پس این مقدار حساس حساب می‌شود
# و در لاگ به‌صورت [REDACTED] نمایش داده می‌شود.
DATABASE_URL=postgresql://gold:gold@localhost:5432/gold

# کلیدهای امضای توکن — حداقل ۳۲ کاراکتر.
# عمداً خالی‌اند: مقدار نمونه‌ی از پیش پرشده همان چیزی است که بعداً
# دست‌نخورده به production می‌رود.
#
#   openssl rand -base64 48
#
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
