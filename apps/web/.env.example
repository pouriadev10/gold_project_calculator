# متغیرهای فرانت (Vite). کپی به `apps/web/.env.local` (gitignore) و تغییر.

# FE-106a — منبع داده‌ی توسعه:
#   خالی یا mock → MSW ِ قراردادمحور در مرورگر (پیش‌فرض؛ بدون Docker/PostgreSQL)
#   real         → بدون MSW؛ `/api` با proxy ِ Vite به API ِ NestJS می‌رود و پیشوند `/api` حذف
#                  می‌شود (API پیشوند سراسری ندارد)
# production همیشه API واقعی است و این متغیر را نادیده می‌گیرد.
VITE_API_MODE=

# مقصد proxy در VITE_API_MODE=real (پیش‌فرض http://localhost:3000، همان پورت docker compose)
VITE_API_PROXY_TARGET=

# ریشه‌ی آدرس API. خالی بگذار تا /api (نسبی) استفاده شود — همانی که MSW در توسعه، proxy ِ Vite در
# VITE_API_MODE=real و reverse proxy در production سرو می‌کنند. فقط برای بک‌اندی روی origin دیگر
# مقدار بده — API پیشوند `/api` ندارد (مثلاً http://localhost:3000) و آن‌وقت CORS ِ سرور لازم است،
# که فعلاً فعال نیست؛ برای توسعه VITE_API_MODE=real را ترجیح بده.
VITE_API_BASE_URL=
