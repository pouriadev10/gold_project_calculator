{
  "name": "@gold/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "node scripts/e2e-not-ready.mjs",
    "analyze": "node ../../scripts/check-bundle-size.mjs",
    "check:circular": "madge --circular --extensions ts,tsx --ts-config tsconfig.json src"
  },
  "dependencies": {
    "@gold/contracts": "workspace:*",
    "@gold/core-calc": "workspace:*",
    "@hookform/resolvers": "^3.9.1",
